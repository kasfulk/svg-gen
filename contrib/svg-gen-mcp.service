[Unit]
Description=svg-gen MCP server (Streamable HTTP)
Documentation=https://github.com/kasfulk/svg-gen
After=network-online.target

[Service]
Type=simple
# SG_TOKEN=... and SG_OUT_DIR=/home/you/svg-gen-out (chmod 600)
EnvironmentFile=%h/.config/svg-gen/env
ExecStart=%h/.local/bin/svg-gen-mcp --http 0.0.0.0:18110
Restart=always
RestartSec=3

[Install]
WantedBy=default.target

